# Public gateway
GATEWAY_PORT=3000
GATEWAY_PREFIX=vite-ride
IDENTITY_GRPC_URL=127.0.0.1:50051
AUTHORIZATION_GRPC_URL=127.0.0.1:50052
TENANTS_GRPC_URL=127.0.0.1:50053

# Internal gRPC listeners and clients
IDENTITY_GRPC_BIND_URL=0.0.0.0:50051
AUTHORIZATION_GRPC_BIND_URL=0.0.0.0:50052
TENANTS_GRPC_BIND_URL=0.0.0.0:50053
NOTIFICATIONS_GRPC_BIND_URL=0.0.0.0:50054
NOTIFICATIONS_GRPC_URL=127.0.0.1:50054

# Local infrastructure
DATABASE_URL_IDENTITY=mongodb://127.0.0.1:27017/vite_ride_identity
REDIS_URL=redis://127.0.0.1:6379

# Replace both values before starting Identity or the Gateway
JWT_ACCESS_TOKEN_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_ACCESS_SECRET
JWT_ACCESS_TOKEN_EXPIRATION_TIME=15m
JWT_REFRESH_TOKEN_SECRET=CHANGE_ME_WITH_A_DIFFERENT_LONG_RANDOM_REFRESH_SECRET
JWT_REFRESH_TOKEN_EXPIRATION_TIME=7d

# Credential-free local drivers
AUTHORIZATION_POLICY_DRIVER=memory
TENANTS_STORE_DRIVER=memory
SMS_DRIVER=dry-run
PUSH_DRIVER=dry-run

# Optional durable Authorization store
# DATABASE_URL_AUTHZ=mongodb://127.0.0.1:27017/vite_ride_authz
# DATABASE_NAME_AUTHZ=vite_ride_authz

# Optional durable Tenants store
# DATABASE_URL_TENANTS=mongodb://127.0.0.1:27017/vite_ride_tenants

# Live provider credentials are intentionally omitted.
