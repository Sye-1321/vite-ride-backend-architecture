{
  "$schema": "https://json.schemastore.org/package",
  "name": "vite-ride-backend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "start:dev:api-gateway": "nest start api-gateway --watch",
    "build:api-gateway": "nest build api-gateway",
    "start:prod:api-gateway": "node dist/apps/api-gateway/main.js",
    "start:dev:identity": "nest start identity-service --watch",
    "build:identity": "nest build identity-service",
    "start:prod:identity": "node dist/apps/identity-service/main.js",
    "start:dev:notifications": "nest start notifications-service --watch",
    "build:notifications": "nest build notifications-service",
    "start:prod:notifications": "node dist/apps/notifications-service/main.js",
    "start:dev:authorization": "nest start authorization-service --watch",
    "build:authorization": "nest build authorization-service",
    "start:prod:authorization": "node dist/apps/authorization-service/main.js",
    "start:dev:tenants": "nest start tenants-service --watch",
    "build:tenants": "nest build tenants-service",
    "start:prod:tenants": "node dist/apps/tenants-service/main.js",
    "start:dev:core": "concurrently --names gateway,identity,authorization,tenants,notifications \"npm run start:dev:api-gateway\" \"npm run start:dev:identity\" \"npm run start:dev:authorization\" \"npm run start:dev:tenants\" \"npm run start:dev:notifications\"",
    "build:core": "npm run build:api-gateway && npm run build:identity && npm run build:authorization && npm run build:tenants && npm run build:notifications",
    "lint": "eslint \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint:fix": "eslint \"apps/**/*.ts\" \"libs/**/*.ts\" --fix",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "test": "jest",
    "test:unit": "jest --config jest.config.js --runInBand",
    "test:integration": "jest --config jest-integration.config.js --runInBand --passWithNoTests",
    "test:core": "npm run test:unit && npm run test:integration",
    "check:core": "npm run lint && npm run format:check && npm run build:core && npm run test:core",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config jest-e2e.config.js",
    "test:e2e:watch": "jest --config jest-e2e.config.js --watch",
    "test:e2e:coverage": "jest --config jest-e2e.config.js --coverage"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^11.1.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cls-hooked": "^4.3.9",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "concurrently": "^8.2.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "grpc-tools": "^1.13.1",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "protobufjs": "^8.0.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "ts-proto": "^2.10.0",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/microservices": "^11.1.9",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.8",
    "@nestjs/platform-socket.io": "^11.1.11",
    "@nestjs/websockets": "^11.1.11",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "casbin-mongodb-adapter": "^1.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cls-hooked": "^4.2.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase-admin": "^13.6.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "nestjs-cls": "^6.1.0",
    "nestjs-request-context": "^4.0.0",
    "nodemailer": "^7.0.10",
    "oxide.ts": "^1.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  }
}
